set Dimension = 2
set Use years instead of seconds = true
set Start time = 0
set End time = 30e6
set Output directory = output
set World builder file = case.wb
set Adiabatic surface temperature = 1573
set Pressure normalization = surface
set Surface pressure = 0

subsection Geometry model
    set Model name = box
    subsection Box
        set X extent = 4000e3
        set Y extent = 1000e3
        set X repetitions = 4
        set Y repetitions = 1
    end
end


subsection Mesh refinement
    set Initial global refinement = 4
    set Initial adaptive refinement = 0
    set Time steps between mesh refinement = 1
end


subsection Boundary velocity model
    set Tangential velocity boundary indicators = left, right, bottom, top
end


subsection Gravity model
    set Model name = vertical
    subsection Vertical
        set Magnitude = 10
    end
end


subsection Initial temperature model
    set List of model names = function
    subsection Function
        set Function expression = 1573
    end
end


subsection Boundary temperature model
    set Fixed temperature boundary indicators = left, right, bottom, top
    set List of model names = constant
    subsection Constant
        set Boundary indicator to temperature mappings = left:1573, right:1573, bottom:1573, top:1573
    end
end


subsection Initial composition model
    set List of model names = world builder
end


subsection Compositional fields
    set Number of fields = 1
    set Names of fields = plate
end


subsection Prescribed solution
    set List of model names = world builder
end


subsection Material model
    set Model name = visco plastic
    set Material averaging = harmonic average only viscosity
    subsection Visco Plastic
        set Densities = background:3300|3300, plate:3380|3380
        set Thermal expansivities = background:0|0, plate:0|0
        set Heat capacities = background:1250|1250, plate:1250|1250
        set Thermal diffusivities = 0, 0
        set Phase transition depths = background:660e3, plate:660e3
        set Phase transition widths = background:5e3, plate:5e3
        set Phase transition temperatures = background:1573, plate:1573
        set Phase transition Clapeyron slopes = background:0, plate:0
        set Viscous flow law = diffusion
        set Prefactors for diffusion creep = background:5e-21|5e-23, plate:2.5e-23|2.5e-23
        set Grain size exponents for diffusion creep = background:0|0, plate:0|0
        set Activation energies for diffusion creep = background:0|0, plate:0|0
        set Activation volumes for diffusion creep = background:0|0, plate:0|0
        set Minimum viscosity = 1e17
        set Maximum viscosity = 1e25
        set Reference strain rate = 1e-15
        set Viscosity averaging scheme = harmonic
        set Yield mechanism = drucker
        set Angles of internal friction = background:0|0, plate:11.5369590328|11.5369590328
        set Cohesions = background:1e30|1e30, plate:4.0824829046e7|4.0824829046e7
        set Maximum yield stress = background:1e30|1e30, plate:1e30|1e30
    end
end

set Nonlinear solver scheme = single Advection, iterated Stokes
set Nonlinear solver tolerance = 1e-3
set Max nonlinear iterations = 50
set Max nonlinear iterations in pre-refinement = 0
set Maximum first time step = 1e3
set Maximum time step = 1e5
set Maximum relative increase in time step = 1e4
set CFL number = 0.5
set Linear solver failure strategy = continue with nonlinear solver

subsection Solver parameters
    subsection Stokes solver parameters
        set Stokes solver type = block GMG
        set GMRES solver restart length = 100
        set Number of cheap Stokes solver steps = 60
        set Use full A block as preconditioner = true
        set Linear solver tolerance = 1e-7
        set Maximum number of expensive Stokes solver steps = 0
    end
end


subsection Postprocess
    set List of postprocessors = velocity statistics, composition statistics, material statistics, visualization
    subsection Visualization
        set Time between graphical output = 5e5
        set List of output variables = material properties, named additional outputs, strain rate, stress
        set Interpolate output = true
    end
end
